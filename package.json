{
  "name": "@hcu-lab.me/mcp-device",
  "version": "1.0.3",
  "description": "MCP Device securely connects a user-owned computer to an authenticated Model Context Protocol gateway.",
  "license": "MIT",
  "author": "Hirohimeow",
  "homepage": "https://github.com/Hiroshimeow/agent-mcp-device",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hiroshimeow/agent-mcp-device.git"
  },
  "bugs": "https://github.com/Hiroshimeow/agent-mcp-device/issues",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "mcp-device": "dist/mcp-device.js",
    "md": "dist/mcp-device.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "device:install": "cd src/device && npm install",
    "device:start": "tsx src/device/device.ts",
    "device:start:dev": "nodemon --watch src/device --exec tsx src/device/device.ts",
    "sync-version": "node scripts/sync-version.js",
    "bump": "node scripts/sync-version.js --bump",
    "bump:minor": "node scripts/sync-version.js --bump --minor",
    "bump:major": "node scripts/sync-version.js --bump --major",
    "build": "shx rm -rf dist/remote-device && shx rm -f dist/device/desktop-commander-integration.js dist/device/desktop-commander-integration.d.ts dist/device/windows-dpapi.js dist/device/windows-dpapi.d.ts && tsc && shx chmod +x dist/*.js && shx mkdir -p dist/data && shx cp src/data/onboarding-prompts.json dist/data/ && node scripts/copy-official-ca.cjs && node scripts/build-ui-runtime.cjs",
    "watch": "tsc --watch",
    "start": "node dist/mcp-device.js",
    "start:debug": "node --inspect-brk=9229 dist/mcp-device.js",
    "prepack": "node scripts/verify-production-trust.cjs && shx rm -rf dist/remote-device && shx rm -f dist/device/desktop-commander-integration.js dist/device/desktop-commander-integration.d.ts dist/device/windows-dpapi.js dist/device/windows-dpapi.d.ts dist/hcu-device.js dist/hcu-device.d.ts dist/track-installation.js dist/setup-claude-server.js dist/uninstall-claude-server.js dist/npm-scripts/setup.js dist/npm-scripts/setup.d.ts dist/npm-scripts/uninstall.js dist/npm-scripts/uninstall.d.ts dist/npm-scripts/verify-ripgrep.js dist/npm-scripts/verify-ripgrep.d.ts",
    "prepare": "npm run build",
    "clean": "shx rm -rf dist",
    "test": "npm run build && node test/run-all-tests.js",
    "test:integration": "npm run build && node test/integration/run-all-integration-tests.js",
    "test:debug": "node --inspect test/run-all-tests.js",
    "link:local": "npm run build && npm link",
    "unlink:local": "npm unlink",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "logs:view": "npm run build && node scripts/view-fuzzy-logs.js",
    "logs:analyze": "npm run build && node scripts/analyze-fuzzy-logs.js",
    "logs:clear": "npm run build && node scripts/clear-fuzzy-logs.js",
    "logs:export": "npm run build && node scripts/export-fuzzy-logs.js",
    "count-tokens": "npm run build && node scripts/count-tokens.js",
    "count-tokens:json": "npm run build && node scripts/count-tokens.js --json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "terminal",
    "claude",
    "ai",
    "command-line",
    "process-management",
    "file-editing",
    "code-editing",
    "diff",
    "patch",
    "block-editing",
    "file-system",
    "text-manipulation",
    "code-modification",
    "surgical-edits",
    "file-operations"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@opendocsg/pdf2md": "^0.2.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vscode/ripgrep": "^1.15.9",
    "cross-fetch": "^4.1.0",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "file-type": "^21.1.1",
    "highlight.js": "^11.11.1",
    "isbinaryfile": "^5.0.4",
    "markdown-it": "^14.1.0",
    "md-to-pdf": "^5.2.5",
    "open": "^10.2.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "proxy-agent": "6.5.0",
    "proxy-from-env": "2.1.0",
    "qrcode-terminal": "^0.12.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.4",
    "tiptap-markdown": "^0.9.0",
    "unified": "^11.0.5",
    "unpdf": "^1.4.0",
    "ws": "^8.18.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.23.5"
  },
  "optionalDependencies": {
    "caffeinate": "^1.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@types/node": "^20.17.24",
    "@types/ws": "^8.18.1",
    "commander": "^13.1.0",
    "esbuild": "^0.27.2",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^24.1.3",
    "nodemon": "^3.0.2",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@mapbox/node-pre-gyp": "^2.0.3",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
