+  if (a.isFile() && b.isFile()) return (await fs.readFile(source)).equals(await fs.readFile(target));
+  if (!a.isDirectory() || !b.isDirectory()) return false;
+  const names = await fs.readdir(source);
+  const existing = (await fs.readdir(target)).filter(name => !top || name !== '.mcp-device-palace-owned');
+  if (names.length !== existing.length || names.some(name => !existing.includes(name))) return false;
+  for (const name of names) if (!await unchangedCopy(path.join(source, name), path.join(target, name), false)) return false;
+  return true;
+}
